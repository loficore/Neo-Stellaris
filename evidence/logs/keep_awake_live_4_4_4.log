    7da26e56dbff3394772da70494e491b38313941815003d9344f88c2137cfc26b  scripts/c4_wiring_probe.py
    1ad3f6f7931a15292bf4fd0e1284c358f6fbf8c7f647ce716ef32e78a09e7ec3  scripts/windows/game_supervisor.py
    3bba05666e59e29ec78c552d4a333dd264c539c869b21ca985cbd6948a9af522  scripts/windows/launch_stellaris.py

    $ ssh Windows_Jiaolong "powershell -NoProfile -Command \"(Get-FileHash C:/temp/keep_awake.py).Hash; (Get-FileHash C:/temp/c4_wiring_probe.py).Hash; (Get-FileHash C:/temp/game_supervisor.py).Hash; (Get-FileHash C:/temp/launch_stellaris.py).Hash\""
    1FAE21A9227A06361DFAE2AD78DE8DB413DDCD0B025796ED6AD438DAA098F0E9
