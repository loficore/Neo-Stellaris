{
  "name": "@neo/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Runtime JS SDK for the Neo-Stellaris QuickJS host (v1: system scope only)",
  "type": "module",
  "bin": {
    "neo": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/runtime.ts"
  },
  "files": [
    "api.def",
    "dist",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "quickjs-emscripten": "0.32.0",
    "typescript": "5.9.3"
  }
}
