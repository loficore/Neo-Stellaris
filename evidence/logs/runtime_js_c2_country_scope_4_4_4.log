Select-String -Path C:/temp/neo_js.log -Pattern "^NEO_SCOPE_OTHER mask"
# 控制组
(Select-String -Path C:/temp/neo_js.log -Pattern "^NEO_JS_CALL").Count
# 实验组 marker
Select-String -Path "$env:USERPROFILE/Documents/Paradox Interactive/Stellaris/logs/game.log" `
  -Pattern "NEO_C2_CTRL_SCOPE_ENTER","NEO_C2_EXP_COUNTRY_ENTER" | ForEach-Object {$_.Line}
